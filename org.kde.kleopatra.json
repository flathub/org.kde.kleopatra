            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.2/src/kleopatra-26.04.2.tar.xz",
                    "sha256": "cafaec7975ef28d557fe1f280c2c62beae86f4c642cf969d7cbc9c05e0ff7aee",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
